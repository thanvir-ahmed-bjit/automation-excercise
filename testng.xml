<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Playwright UI Automation - TestNG Suite
  parallel: classes (each class runs in its own thread)
  thread-count: 3 (adjust for CI runner capacity)
-->
<suite name="Playwright UI Automation Suite"
       parallel="none"
       thread-count="1"
       data-provider-thread-count="1"
       verbose="1">


    <test name="Automation Exercise End-to-End">
        <classes>
            <class name="com.bjitgroup.tests.SignupTest"/>
            <class name="com.bjitgroup.tests.ProductPage"/>
            <class name="com.bjitgroup.tests.PurchaseProduct"/>
            <class name="com.bjitgroup.tests.DeleteUser"/>
        </classes>
    </test>

