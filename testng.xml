<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Playwright UI Automation - TestNG Suite
  parallel: classes (each class runs in its own thread)
  thread-count: 3 (adjust for CI runner capacity)
-->
<suite name="Playwright UI Automation Suite"
       parallel="classes"
       thread-count="3"
       data-provider-thread-count="2"
       verbose="1">


    <!-- Smoke / Authentication -->
    <test name="Login Tests">
        <classes>
            <class name="com.bjitgroup.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Logout Tests">
        <classes>
            <class name="com.bjitgroup.tests.LogoutTest"/>
        </classes>
    </test>

    <!-- Admin User CRUD -->
    <test name="User Management Tests">
        <classes>
            <class name="com.bjitgroup.tests.UserManagementTest"/>
        </classes>
    </test>

</suite>
